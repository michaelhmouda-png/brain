# Copy names only into the matching Vercel Preview or Production environment.
# Public values are embedded at build time; never promote one environment's build
# artifact into the other environment.
BRAIN_DEPLOYMENT_ENV=preview
NEXT_PUBLIC_APP_URL=https://preview.example.com
NEXT_PUBLIC_SUPABASE_URL=https://project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key

# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
CRON_SECRET=replace-with-at-least-32-random-characters
NOTIFICATION_WORKER_SECRET=replace-with-a-different-32-character-secret
TASK_EVIDENCE_WORKER_SECRET=replace-with-another-32-character-secret
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_VISION_MODEL=replace-with-approved-vision-model
NEXT_PUBLIC_VAPID_PUBLIC_KEY=replace-with-vapid-public-key
VAPID_PRIVATE_KEY=replace-with-vapid-private-key
VAPID_SUBJECT=mailto:operations@example.com

# Brain Agent server-side peppers.
BRAIN_AGENT_TOKEN_PEPPER=replace-with-at-least-32-random-characters
BRAIN_AGENT_RATE_LIMIT_PEPPER=replace-with-a-different-32-character-value
